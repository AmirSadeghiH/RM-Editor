# BeatLab environment configuration — copy to .env and fill in values.
# All secrets must come from the environment. Never commit a real .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production
DJANGO_ENV=development
# 1 (on) is fine for local development. In production it MUST be 0: the
# application refuses to start when DJANGO_ENV=production and DJANGO_DEBUG=1.
DJANGO_DEBUG=1
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated hostnames. Must NOT be empty or "*" in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins for CSRF (needed behind HTTPS reverse proxies).
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------------------
# Database (PostgreSQL in Docker/production)
# ---------------------------------------------------------------------------
# Either set DB_URL ...
#   DB_URL=postgresql://beatlab:beatlab@db:5432/beatlab
# ... or the individual POSTGRES_* variables below.
# When nothing is set, development falls back to a local SQLite database
# (fine for running tests locally; Docker Compose always uses PostgreSQL).
DB_URL=postgresql://beatlab:beatlab@db:5432/beatlab
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
#POSTGRES_NAME=beatlab
#POSTGRES_USER=beatlab
#POSTGRES_PASSWORD=beatlab

# ---------------------------------------------------------------------------
# Media / files
# ---------------------------------------------------------------------------
# Where uploaded audio and rendered exports are stored.
BEATLAB_MEDIA_ROOT=/var/lib/beatlab/media

# ---------------------------------------------------------------------------
# Celery / Redis
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Set to 1 to run export jobs synchronously inside the web process.
# Only for local development without Redis. Never enable in production.
BEATLAB_CELERY_EAGER=0
# Hard subprocess timeout for one FFmpeg render, in seconds.
BEATLAB_RENDER_TIMEOUT=600

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Create a bot with @BotFather, then paste the token here.
# Leave empty to run the web app in browser development mode (bot will idle).
TELEGRAM_BOT_TOKEN=
# HTTPS URL of the deployed Mini App, configured on the bot via BotFather.
TELEGRAM_WEBAPP_URL=
# Maximum accepted age (seconds) of Telegram.WebApp.initData for login.
TELEGRAM_AUTH_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Development-only auth
# ---------------------------------------------------------------------------
# Enables POST /api/auth/dev/ so the editor can be used in a plain browser.
# Defaults to on when DJANGO_ENV != production and no bot token is set.
# The application refuses to start if this is enabled with DJANGO_ENV=production.
BEATLAB_DEV_AUTH=

# ---------------------------------------------------------------------------
# Limits (optional overrides — seconds / bytes / counts)
# ---------------------------------------------------------------------------
#BEATLAB_MAX_UPLOAD_BYTES=26214400
#BEATLAB_MAX_SOURCE_DURATION=600
#BEATLAB_MAX_ASSETS_PER_PROJECT=8
#BEATLAB_MAX_CLIPS_PER_PROJECT=30
#BEATLAB_MAX_TRACKS=8
#BEATLAB_MAX_EXPORT_DURATION=600

# ---------------------------------------------------------------------------
# Docker / deployment extras
# ---------------------------------------------------------------------------
# Port published by the web container in docker-compose.
#WEB_PORT=8000
# PostgreSQL superuser password for the db container (dev default is fine locally).
#POSTGRES_DB=beatlab
#POSTGRES_USER=beatlab
#POSTGRES_PASSWORD=beatlab

# ---------------------------------------------------------------------------
# Production checklist (copy into .env for a real deployment)
# ---------------------------------------------------------------------------
# DJANGO_ENV=production
# DJANGO_DEBUG=0            # REQUIRED: the app refuses to start with DEBUG=1
# DJANGO_SECRET_KEY=<long random string, 32+ chars, not "change-me...">
# ALLOWED_HOSTS=your-domain.example          # explicit hosts, no "*"
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# BEATLAB_DEV_AUTH=0        # dev login must stay disabled in production
# DJANGO_SECURE_SSL_REDIRECT=1
#
# Uploaded audio and rendered exports are private: /media/ is never served
# by Django in production. Clients download through the authenticated,
# owner-scoped endpoints /api/assets/<uuid>/audio/ and
# /api/exports/<uuid>/download/.
